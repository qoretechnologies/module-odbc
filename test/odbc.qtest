#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires QUnit

%try-module odbc
%define NoOdbc
%endtry

%exec-class OdbcTest

class OdbcTest inherits QUnit::Test {
    public {
        TimeZone utcTz = new TimeZone(0);
        *string connStr;

        # Generally compatible types will be here.
        hash Columns = {
            "sint": {
                "type": "SMALLINT",
                "values": (1, 0, 32767, -32768),
            },
            "sintodb": {
                "type": "SMALLINT",
                "values": odbc_bind(ODBCT_SSHORT, (1, 0, 32767, -32768)),
                "expected": (1, 0, 32767, -32768),
            },
            "i": {
                "type": "INTEGER",
                "values": (2147483647, 0, -1, -2147483648),
            },
            "iodb": {
                "type": "INTEGER",
                "values": odbc_bind(ODBCT_SLONG, (2147483647, 0, -1, -2147483648)),
                "expected": (2147483647, 0, -1, -2147483648),
            },
            "decim": {
                "type": "DECIMAL(5,2)",
                "values": (123.45n, 0.0n, 999.99n, -999.99n),
            },
            "num": {
                "type": "NUMERIC(5,2)",
                "values": (-123.45n, 0.0n, 999.99n, -999.99n),
            },
            "fltp": {
                "type": "FLOAT(53)",
                "values": (1.72, 3.1456789765432, 0.0, -2.7218281828),
            },
            "r": {
                "type": "REAL",
                "values": (0.00390625, 0.0078125, -0.0078125, 0.0),
            },
            "rodb": {
                "type": "REAL",
                "values": odbc_bind(ODBCT_FLOAT, (0.00390625, 0.0078125, -0.0078125, 0.0)),
                "expected": (0.00390625, 0.0078125, -0.0078125, 0.0),
            },
            "flt": {
                "type": "FLOAT",
                "values": (0.00390625, 0.0078125, -0.0078125, 0.0),
            },
            "dbl": {
                "type": "DOUBLE PRECISION",
                "values": (1.72, 3.1456789765432, 0.0, -2.7218281828),
            },
            "dt": {
                "type": "DATE",
                "values": odbc_bind(ODBCT_DATE, (2016-01-11, 1970-01-01, 2020-05-20, 1987-01-30)),
                "expected": (2016-01-11, 1970-01-01, 2020-05-20, 1987-01-30),
            },
        };
        list ColumnNamesAndTypes;

        # MySQL-specific types. http://dev.mysql.com/doc/refman/5.7/en/data-types.html
        hash MysqlColumns = {
            "myvc": {
                "type": "VARCHAR(128)",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
            },
            "myc": {
                "type": "CHAR(128)",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
            },
            "mybin": {
                "type": "BINARY(64)",
                "values": (<bead>, <feed>, <beadaabbccdd>, <1122aabb3344ccdd55667788>),
                "expected": (),
            },
            "myvbin": {
                "type": "VARBINARY(64)",
                "values": (<bead>, <feed>, <beadaabbccdd>, <1122aabb3344ccdd55667788>),
            },
            "myblob": {
                "type": "BLOB(64)",
                "values": (<bead>, <feed>, <beadaabbccdd>, <1122aabb3344ccdd55667788>),
            },
            "mybool": {
                "type": "BOOLEAN",
                "values": (True, False, True, True),
                "expected": (1, 0, 1, 1),
            },
            "mytext": {
                "type": "TEXT(128)",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
            },
            "mybint": {
                "type": "BIGINT",
                "values": (2200100100, -9223372036854775807, 0, 9223372036854775807),
            },
            "mytint": {
                "type": "TINYINT",
                "values": (1, 0, 127, -128),
            },
            "mytintodb": {
                "type": "TINYINT",
                "values": odbc_bind(ODBCT_STINYINT, (1, 0, 127, -128)),
                "expected": (1, 0, 127, -128),
            },
            "myutint": {
                "type": "TINYINT UNSIGNED",
                "values": (1, 0, 127, 255),
            },
            "myutintodb": {
                "type": "TINYINT UNSIGNED",
                "values": odbc_bind(ODBCT_UTINYINT, (1, 0, 127, 255)),
                "expected": (1, 0, 127, 255),
            },
            "mymint": {
                "type": "MEDIUMINT",
                "values": (1, 0, 8388607, -8388608),
            },
            "mymintunsig": {
                "type": "MEDIUMINT UNSIGNED",
                "values": (1, 0, 127, 16777215),
            },
            "mytm": {
                "type": "TIME",
                "values": odbc_bind(ODBCT_TIME, (00:00:00Z, 05:23:17Z, 03:59:20Z, 14:15:16Z)),
                "expected": (0s, 5*60m+23m+17s, 3*60m+59m+20s, 14*60m+15m+16s),
            },
            "mydtime": {
                "type": "DATETIME",
                "values": (2016-01-11T00:00:00, 2016-01-11T05:23:17, 2016-01-11T03:00:20, 2016-01-11T14:15:16),
                "expected": (),
            },
            "myyr": {
                "type": "YEAR",
                "values": (2016, 2012, 2016, 1970),
            },
            "mytstamp": {
                "type": "TIMESTAMP(3)",
                "values": (2016-01-11T00:00:00, 2016-01-11T05:23:17.456, 2016-01-11T03:00:20.789, 2016-01-11T14:15:16),
                "expected": (),
            },
        };

        # PostgreSQL-specific types. https://www.postgresql.org/docs/9.5/static/datatype.html
        hash PgsqlColumns = {
            "pgvc": {
                "type": "VARCHAR(128)",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", ""),
            },
            "pgc": {
                "type": "CHAR(64)",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", ""),
                "expected": (
                    "text",
                    "lorem",
                    "Příliš žluťoučký kůň úpěl ďábelské ódy",
                    "",
                ),
            },
            "pgbin": {
                "type": "bytea",
                "values": (<bead>, <feed>, <beadaabbccdd>, <1122aabb3344ccdd55667788>),
            },
            "pgbool": {
                "type": "BOOLEAN",
                "values": (True, False, True, True),
            },
            "pgmoney": {
                "type": "MONEY",
                "values": (123.45n, 0.0n, 92233720368547758.07n, -92233720368547758.08n),
                "expected": (123.45, 0.0, 92233720368547758.07, -92233720368547758.08),
            },
            "pgbint": {
                "type": "BIGINT",
                "values": (2200100100, -9223372036854775807, 0, 9223372036854775807),
            },
            "pgtm": {
                "type": "TIME",
                "values": odbc_bind(ODBCT_TIME, (00:00:00Z, 05:23:17Z, 03:59:20Z, 14:15:16Z)),
                "expected": (0s, 5*60m+23m+17s, 3*60m+59m+20s, 14*60m+15m+16s),
            },
            "pgtstamp": {
                "type": "TIMESTAMP",
                "values": (2016-01-11T00:00:00, 2016-01-11T05:23:17.456, 2016-01-11T03:00:20.789, 2016-01-11T14:15:16),
                "expected": (),
            },
        };

        # Oracle-specific types. https://docs.oracle.com/cd/B28359_01/server.111/b28318/datatype.htm#CNCPT012
        hash OracleColumns = {
            "orablob": {
                "type": "BLOB",
                "values": (<bead>, binary(), <beadaabbccdd>, <1122aabb3344ccdd55667788>),
                "expected": (<bead>, NULL, <beadaabbccdd>, <1122aabb3344ccdd55667788>),
            },
            "oralongraw": {
                "type": "LONG RAW(64)",
                "values": (<bead>, binary(), <beadaabbccdd>, <1122aabb3344ccdd55667788>),
                "expected": (<bead>, NULL, <beadaabbccdd>, <1122aabb3344ccdd55667788>),
            },
            "oraclob": {
                "type": "CLOB",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
                "expected": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
            },
            "oranclob": {
                "type": "NCLOB",
                "values": (
                    convert_encoding("text", "UTF16"),
                    convert_encoding("lorem", "UTF16"),
                    convert_encoding("Příliš žluťoučký kůň úpěl ďábelské ódy", "UTF16"),
                    convert_encoding("ipsum dolor", "UTF16")
                ),
            },
            "orac": {
                "type": "CHAR(128)",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
                "expected": (
                    "text",
                    "lorem",
                    "Příliš žluťoučký kůň úpěl ďábelské ódy",
                    "ipsum dolor"
                ),
            },
            "oravc": {
                "type": "VARCHAR(128)",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
                "expected": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
            },
            "oravc2": {
                "type": "VARCHAR2(128)",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
                "expected": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
            },
            "oranc": {
                "type": "NCHAR(64)",
                "values": (
                    convert_encoding("text", "UTF16"),
                    convert_encoding("lorem", "UTF16"),
                    convert_encoding("Příliš žluťoučký kůň úpěl ďábelské ódy", "UTF16"),
                    convert_encoding("ipsum dolor", "UTF16")
                ),
                "expected": (
                    convert_encoding("text", "UTF16"),
                    convert_encoding("lorem", "UTF16"),
                    convert_encoding("Příliš žluťoučký kůň úpěl ďábelské ódy", "UTF16"),
                    convert_encoding("ipsum dolor", "UTF16")
                ),
            },
            "oranvc2": {
                "type": "NVARCHAR2(64)",
                "values": (
                    convert_encoding("text", "UTF16"),
                    convert_encoding("lorem", "UTF16"),
                    convert_encoding("Příliš žluťoučký kůň úpěl ďábelské ódy", "UTF16"),
                    convert_encoding("ipsum dolor", "UTF16")
                ),
            },
            "oranumbr": {
                "type": "NUMBER(38,10)",
                "values": (-12300000.4567891234n, 0.0n, 999888777666.5554443332n, -999888777666.5554443332n),
            },
            "orabinflt": {
                "type": "BINARY_FLOAT",
                "values": (0.00390625, 0.0078125, -0.0078125, 0.0),
            },
            "orabinfltodb": {
                "type": "BINARY_FLOAT",
                "values": odbc_bind(ODBCT_FLOAT, (0.00390625, 0.0078125, -0.0078125, 0.0)),
                "expected": (0.00390625, 0.0078125, -0.0078125, 0.0),
            },
            "orabindbl": {
                "type": "BINARY_DOUBLE",
                "values": (1.72, 3.1456789765432, 0.0, -2.7218281828),
            },
            "oratstamp": {
                "type": "TIMESTAMP",
                "values": (2016-01-11T00:00:00, 2016-01-11T05:23:17.456, 2016-01-11T03:00:20.789, 2016-01-11T14:15:16),
                "expected": (),
            },
        };

        # MSSQL-specific types. https://msdn.microsoft.com/en-us/library/ms187752.aspx
        hash MssqlColumns = {
            "msvc": {
                "type": "VARCHAR(64)",
                "values": ("text", "lorem", "Çûëýåxyz", "ipsum dolor"),
            },
            "msc": {
                "type": "CHAR(64)",
                "values": ("text", "lorem", "Çûëýåxyz", "ipsum dolor"),
            },
            "msnvc": {
                "type": "NVARCHAR(64)",
                "values": ("text", "lorem", "Çûëýåxyz", "ipsum dolor"),
            },
            "msnc": {
                "type": "NCHAR(64)",
                "values": ("text", "lorem", "Çûëýåxyz", "ipsum dolor"),
            },
            "msbin": {
                "type": "BINARY(64)",
                "values": (<bead>, <feed>, <beadaabbccdd>, <1122aabb3344ccdd55667788>),
                "expected": (),
            },
            "msvbin": {
                "type": "VARBINARY(64)",
                "values": (<bead>, <feed>, <beadaabbccdd>, <1122aabb3344ccdd55667788>),
                "expected": (<bead00000000000000000000>, <feed00000000000000000000>, <beadaabbccdd000000000000>, <1122aabb3344ccdd55667788>),
            },
            "msblob": {
                "type": "BLOB(64)",
                "values": (<bead>, <feed>, <beadaabbccdd>, <1122aabb3344ccdd55667788>),
            },
            "msbool": {
                "type": "BOOLEAN",
                "values": (True, False, True, True),
                "expected": (1, 0, 1, 1),
            },
            "mstext": {
                "type": "TEXT(128)",
                "values": ("text", "lorem", "Příliš žluťoučký kůň úpěl ďábelské ódy", "ipsum dolor"),
            },
            "msbint": {
                "type": "BIGINT",
                "values": (2200100100, -9223372036854775807, 0, 9223372036854775807),
            },
            "mstint": {
                "type": "TINYINT",
                "values": (1, 0, 255, 128),
            },
            "mstintodb": {
                "type": "TINYINT",
                "values": odbc_bind(ODBCT_UTINYINT, (1, 0, 255, 128)),
                "expected": (1, 0, 255, 128),
            },
            /*"msbit": {
                "type": "BIT",
                "values": (0, 1, 1, 0),
            },*/
            /*"mstm": {
                "type": "TIME",
                "values": odbc_bind(ODBCT_TIME, (00:00:00Z, 05:23:17Z, 03:59:20Z, 14:15:16Z)),
                "expected": (0s, 5*60m+23m+17s, 3*60m+59m+20s, 14*60m+15m+16s),
            },
            "msdtime": {
                "type": "DATETIME",
                "values": (2016-01-11T00:00:00, 2016-01-11T05:23:17, 2016-01-11T03:00:20, 2016-01-11T14:15:16),
                "expected": (),
            },*/
        };
    }

    private {
        *Datasource ds;
        const tableName = "odbc_test_table";
        bool mysqlDB = False;
        bool pgsqlDB = False;
        bool oracleDB = False;
        bool mssqlDB = False;
        bool sybaseDB = False;
        bool firebirdDB = False;
        bool sqliteDB = False;

        bool no_odbc;
    }

    constructor() : QUnit::Test("OdbcTest", "1.0", \ARGV) {
        addTestCase("Basic test", \basicTest());
        addTestCase("Types test", \typesTest());
        addTestCase("Timezone test", \timezoneTest());
        addTestCase("Array bind test", \arrayBindTest());
        addTestCase("Connection info test", \connectionInfoTest());
        addTestCase("Options test", \optionsTest());
        addTestCase("Statement operations test", \statementOpsTest());
        set_return_value(main());
    }

    destructor() {}

    globalSetUp() {
%ifdef NoOdbc
        no_odbc = True;
        if (no_odbc) {
            return;
        }
%endif

        connStr = ENV.QORE_DB_CONNSTR_ODBC;
        if (!connStr) {
            no_odbc = True;
            return;
        }

        if (!ENV.NLS_LANG) {
            setenv("NLS_LANG", "AMERICAN_AMERICA.AL32UTF8");
        }

        try {
            initDatasource(connStr);
        } catch (hash<ExceptionInfo> ex) {
            printf("Exception happened in datasource initialization:\n%s: %s\n", ex.err, ex.desc);
            exit(1);
        }

        prepareDBSpecificInit();
    }

    globalTearDown() {
        if (ds) {
            try {
                ds.exec("DROP TABLE " + tableName);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "ODBC-EXEC-ERROR")
                    rethrow;
            }
            ds.commit();
            ds.close();
        }
    }

    string getVersionString(int version) {
        int major = version / 1000000;
        version -= major * 1000000;
        int minor = version / 10000;
        version -= minor * 10000;
        return sprintf("%d.%d.%d", major, minor, version);
    }

    initDatasource(string connStr) {
        ds = new Datasource(connStr);
        if (ds.getDriverName() != "odbc") {
            printf("Cannot execute the odbc tests on a connection using driver %y (expecting \"odbc\")\n",
                ds.getDriverName());
            exit(1);
        }
        ds.open();

        if (m_options.verbose > 2) {
            auto serverVer = ds.getServerVersion();
            int clientVer = ds.getClientVersion();
            printf("server version: %y\n", serverVer);
            printf("client version: %s (%d)\n", getVersionString(clientVer), clientVer);
        }
    }

    prepareDBSpecificInit() {
        string typesTable = "odbc_types_test";
        try { ds.exec("DROP TABLE " + typesTable); } catch (hash<ExceptionInfo> e) {}

        sqliteDB = ds.getDriverRealName() == "SQLite";
        if (!sqliteDB) {
            # Test if connected to a MySQL database.
            try { # LINESTRING is a MySQL-only datatype.
                ds.exec("CREATE TABLE " + typesTable + " (ls LINESTRING)");
                mysqlDB = True;
                try { ds.exec("DROP TABLE " + typesTable); } catch (hash<ExceptionInfo> e) {}
            } catch (hash<ExceptionInfo> e) {
                mysqlDB = False;
            }

            # Test if connected to a PostgreSQL database.
            try { # BYTEA is a PostgreSQL-only datatype.
                ds.exec("CREATE TABLE " + typesTable + " (bt bytea)");
                pgsqlDB = True;
                try { ds.exec("DROP TABLE " + typesTable); } catch (hash<ExceptionInfo> e) {}
            } catch (hash<ExceptionInfo> e) {
                pgsqlDB = False;
            }

            # Test if connected to an Oracle database.
            try { # BINARY_FLOAT is an Oracle-only datatype.
                ds.exec("CREATE TABLE " + typesTable + " (bf BINARY_FLOAT)");
                oracleDB = True;
                try { ds.exec("DROP TABLE " + typesTable); } catch (hash<ExceptionInfo> e) {}
            } catch (hash<ExceptionInfo> e) {
                oracleDB = False;
            }

            # Test if connected to a MSSQL database.
            try { # IMAGE is a MSSQL-only datatype.
                ds.exec("CREATE TABLE " + typesTable + " (img IMAGE)");
                mssqlDB = True;
                try { ds.exec("DROP TABLE " + typesTable); } catch (hash<ExceptionInfo> e) {}
            } catch (hash<ExceptionInfo> e) {
                mssqlDB = False;
            }

            # Test if connected to a Sybase database.
            try { # UNIQUEIDENTIFIERSTR is a Sybase-only datatype.
                ds.exec("CREATE TABLE " + typesTable + " (uis UNIQUEIDENTIFIERSTR)");
                sybaseDB = True;
                try { ds.exec("DROP TABLE " + typesTable); } catch (hash<ExceptionInfo> e) {}
            } catch (hash<ExceptionInfo> e) {
                sybaseDB = False;
            }

            # Test if connected to Firebird
            try {
                ds.select("select rdb$relation_name as name from rdb$relations where rdb$relation_name = 'x'");
                firebirdDB = True;
            } catch (hash<ExceptionInfo> ex) {
                firebirdDB = False;
            }
        }

        if (oracleDB) {
            mysqlDB = False;
            ds.setOption("bigint-string", True);
        }
        if (sybaseDB) {
            mssqlDB = False;
        }

        if (m_options.verbose > 2) {
            printf("MySQL DB: %s\n", mysqlDB ? "True" : "False");
            printf("PostgreSQL DB: %s\n", pgsqlDB ? "True" : "False");
            printf("Oracle DB: %s\n", oracleDB ? "True" : "False");
            printf("MSSQL DB: %s\n", mssqlDB ? "True" : "False");
            printf("Sybase DB: %s\n", sybaseDB ? "True" : "False");
            printf("Firebird DB: %s\n", firebirdDB ? "True" : "False");
            printf("SQLite DB: %s\n", sqliteDB ? "True" : "False");
        }

        if (sqliteDB) {
            Columns.decim.expected = ("123.45", "0", "999.99", "-999.99");
            Columns.num.expected = (-123.45, 0.0, 999.99, -999.99);
        }

        # Try additional MySQL types.
        if (mysqlDB) {
            Columns.fltp.expected = (1.72, 3.145679, 0.0, -2.721828);
            Columns.r.expected = (0.003906, 0.007812, -0.007812, 0.0);
            Columns.rodb.expected = (0.003906, 0.007812, -0.007812, 0.0);
            Columns.flt.expected = (0.0039059999398887157, 0.0078119998797774315, -0.0078119998797774315, 0.0);
            Columns.dbl.expected = (1.72, 3.145679, 0.0, -2.721828);

            string mysqlTable = "mysql_types_test";
            try { ds.exec("DROP TABLE " + mysqlTable); } catch (hash<ExceptionInfo> e) {}
            HashIterator mysql(MysqlColumns);
            while (mysql.next()) {
                try {
                    ds.exec("CREATE TABLE " + mysqlTable + " (" + mysql.getKey() + " " + mysql.getValue().type + ")");
                } catch (hash<ExceptionInfo> e) { continue; }
                try { ds.exec("DROP TABLE " + mysqlTable); } catch (hash<ExceptionInfo> e) {}

                # Add the type to the typesTest Columns.
                Columns{mysql.getKey()} = mysql.getValue();

                if (mysql.getKey() == "mybin") {
                    for (int i = 0; i < Columns.mybin.values.size(); i++) {
                        push Columns.mybin.expected, Columns.mybin.values[i];
                        reference exp = \Columns.mybin.expected[i];
                        for (int j = exp.size(); j < 64; j++)
                            exp += <00>;
                    }
                } else if (mysql.getKey() == "mydtime") {
                    Columns.mydtime.expected = Columns.mydtime.values;
                } else if (mysql.getKey() == "mytstamp") {
                    Columns.mytstamp.expected = Columns.mytstamp.values;
                }
            }
        }

        # Try additional PostgreSQL types.
        if (pgsqlDB) {
            string pgsqlTable = "pgsql_types_test";
            try { ds.exec("DROP TABLE " + pgsqlTable); } catch (hash<ExceptionInfo> e) {}
            HashIterator pgsql(PgsqlColumns);
            while (pgsql.next()) {
                try {
                    ds.exec("CREATE TABLE " + pgsqlTable + " (" + pgsql.getKey() + " " + pgsql.getValue().type + ")");
                } catch (hash<ExceptionInfo> e) { continue; }
                try { ds.exec("DROP TABLE " + pgsqlTable); } catch (hash<ExceptionInfo> e) {}

                # Add the type to the typesTest Columns.
                Columns{pgsql.getKey()} = pgsql.getValue();

                if (pgsql.getKey() == "pgtstamp") {
                    for (int i = 0; i < Columns.pgtstamp.values.size(); i++) {
                        push Columns.pgtstamp.expected, utcTz.date(Columns.pgtstamp.values[i]);
                    }
                }
            }
        }

        # Try additional Oracle types.
        if (oracleDB) {
            string oracleTable = "oracle_types_test";
            try { ds.exec("DROP TABLE " + oracleTable); } catch (hash<ExceptionInfo> e) {}
            HashIterator oracle(OracleColumns);
            while (oracle.next()) {
                try {
                    ds.exec("CREATE TABLE " + oracleTable + " (" + oracle.getKey() + " " + oracle.getValue().type + ")");
                } catch (hash<ExceptionInfo> e) { continue; }
                try { ds.exec("DROP TABLE " + oracleTable); } catch (hash<ExceptionInfo> e) {}

                # Add the type to the typesTest Columns.
                Columns{oracle.getKey()} = oracle.getValue();

                if (oracle.getKey() == "oratstamp") {
                    for (int i = 0; i < Columns.oratstamp.values.size(); i++) {
                        push Columns.oratstamp.expected, Columns.oratstamp.values[i];
                    }
                }
            }
            Columns.sint.expected = map number($1), Columns.sint.values;
            Columns.sintodb.expected = map number($1), Columns.sintodb.expected;
            Columns.i.expected = map number($1), Columns.i.values;
            Columns.iodb.expected = map number($1), Columns.iodb.expected;
        }

        # Try additional MSSQL types.
        if (mssqlDB) {
            string mssqlTable = "mssql_types_test";
            try { ds.exec("DROP TABLE " + mssqlTable); } catch (hash<ExceptionInfo> e) {}
            HashIterator mssql(MssqlColumns);
            while (mssql.next()) {
                try {
                    ds.exec("CREATE TABLE " + mssqlTable + " (" + mssql.getKey() + " " + mssql.getValue().type + ")");
                } catch (hash<ExceptionInfo> e) { continue; }
                try { ds.exec("DROP TABLE " + mssqlTable); } catch (hash<ExceptionInfo> e) {}

                # Add the type to the typesTest Columns.
                Columns{mssql.getKey()} = mssql.getValue();

                if (mssql.getKey() == "msdtime") {
                    for (int i = 0; i < Columns.msdtime.values.size(); i++) {
                        push Columns.msdtime.expected, utcTz.date(Columns.msdtime.values[i]);
                    }
                } else if (mssql.getKey() == "msbin") {
                    for (int i = 0; i < Columns.msbin.values.size(); i++) {
                        push Columns.msbin.expected, Columns.msbin.values[i];
                        reference exp = \Columns.msbin.expected[i];
                        for (int j = exp.size(); j < 64; j++)
                            exp += <00>;
                    }
                }
            }
        }

        # Prepare final list of columns and their types.
        foreach hash col in (Columns.pairIterator()) {
            ColumnNamesAndTypes += col.key + " " + col.value.type;
        }
    }

    trimHashOfLists(reference<auto> h) {
        foreach string k in (keys h) {
            h{k} = trim h{k};
        }
    }

    trimListOfHashes(reference<auto> lst) {
        for (int i = 0; i < lst.size(); i++) {
            lst[i] = trim lst[i];
        }
    }

    auto getColumn(ColumnarResult result, string name) {
        string cname = result.columnNames().contains(name) ? name : name.upr();
        return result.getColumn(cname);
    }

    list asList(auto value) {
        return value.type() == Type::List ? value : value.toList();
    }

    basicTest() {
        if (no_odbc) {
            testSkip("no ODBC driver present");
        }

        {
            Datasource test = new Datasource("odbc", "abc", "xyz");
            assertThrows("ODBC-CONNECTION-ERROR", sub() { test.open(); });
        }

        try {
            ds.exec("drop table " + tableName);
        } catch (hash<ExceptionInfo> ex) {
            # ignore exception
        }

        auto ret = ds.exec("CREATE TABLE " + tableName + " (id int PRIMARY KEY, txt varchar(128), txt1 char(10))");
        assertTrue(ret == 0 || ret == -1 || ret.typeCode() == NOTHING);
        ds.commit();

        assertEq(1, ds.exec("INSERT INTO " + tableName + " (id, txt, txt1) VALUES (1, 'abcdef123456', 'abc123')"));
        ds.commit();

        {
            string str = "test 789 abc lorem ipsum";
            assertEq(1, ds.exec("INSERT INTO " + tableName + " (id, txt) VALUES (%v, %v)", 2,
                str));
            assertEq(str, ds.selectRow("select * from %s where id = %v", tableName, 2).txt);
            assertEq(str, ds.selectRow("select * from %s where id = %v and txt = %v", tableName, 2, str).txt);
        }
        ds.commit();

        assertThrows("ODBC-BIND-ERROR", "bind.*object",
            sub() { ds.exec("INSERT INTO " + tableName + " (id, txt) VALUES (%v, %v)", new Mutex()); });
        assertThrows("ODBC-BIND-ERROR", "hash parameter not in correct format for odbc_bind",
            sub() { ds.exec("INSERT INTO " + tableName + " (id, txt) VALUES (%v, %v)", 3, {}); });

        assertEq(1, ds.exec("INSERT INTO " + tableName + " (id, txt) VALUES (%v, %v)", odbc_bind(ODBCT_SLONG, 3),
            "scalar odbc_bind"));
        ds.commit();

        assertThrows("ODBC-EXEC-ERROR", "error in statement execution", sub() { ds.exec("bla bla bla"); });

        hash results1 = {
            "id": (1, 2, 3),
            "txt": ("abcdef123456", "test 789 abc lorem ipsum", "scalar odbc_bind"),
            "txt1": ("abc123", NULL, NULL),
        };
        list results2 = (
            {"id": 1, "txt": "abcdef123456", "txt1": "abc123"},
            {"id": 2, "txt": "test 789 abc lorem ipsum", "txt1": NULL},
            {"id": 3, "txt": "scalar odbc_bind", "txt1": NULL},
        );

        on_error ds.rollback();
        ret = ds.exec("SELECT * FROM " + tableName);
        if (mssqlDB)
            trimHashOfLists(\ret);
        assertEq(results1, ret);

        ret = ds.select("SELECT * FROM " + tableName);
        if (mssqlDB)
            trimHashOfLists(\ret);
        assertEq(results1, ret);

        ret = ds.selectRows("SELECT * FROM " + tableName);
        if (mssqlDB)
            trimListOfHashes(\ret);
        assertEq(results2, ret);

        ColumnarResult columnar = ds.selectColumnar("SELECT id, txt FROM " + tableName + " ORDER BY id");
        assertEq(3, columnar.numRows());
        assertEq(2, columnar.numCols());
        assertEq((1, 2, 3), map int($1), asList(getColumn(columnar, "id")));
        assertEq(results1.txt, asList(getColumn(columnar, "txt")));

        ColumnarResult empty = ds.selectColumnar("SELECT id, txt FROM " + tableName + " WHERE id < 0");
        assertEq(0, empty.numRows());
        assertEq(2, empty.numCols());

        {
            SQLStatement stmt = ds.getSQLStatement();
            stmt.prepare("select * from " + tableName);
            list<hash<auto>> rows = map $1, stmt;
            assertEq(results2, rows);
        }

        ds.exec("DROP TABLE " + tableName);
        ds.commit();
    }

    typesTest() {
        if (no_odbc) {
            testSkip("no ODBC driver present");
        }

        if (m_options.verbose > 2) {
            printf("\n**************************\n");
            printf("The following columns and their types are tested in the 'types test':\n");
            foreach string col in (ColumnNamesAndTypes.iterator()) {
                printf("%s\n", col);
            }
            printf("**************************\n\n");
        }

        ds.setOption("numeric-numbers", True);
        try {
            ds.exec("DROP TABLE " + tableName);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "ODBC-EXEC-ERROR")
                rethrow;
        }
        ds.commit();

        string def = sprintf(" (%s)", foldl $1 + ", " + $2, ColumnNamesAndTypes);
        auto ret = ds.exec("CREATE TABLE " + tableName + def);
        assertTrue(ret == 0 || ret == -1 || ret.typeCode() == NOTHING);
        ds.commit();

        list<auto> arguments = ();
        foreach hash<auto> col in (Columns.pairIterator()) {
            push arguments, col.value.values;
        }

        string valdef = "";
        for (int i = 0; i < ColumnNamesAndTypes.size(); i++)
            valdef += "%v,";
        valdef = valdef.substr(0, valdef.size()-1);

        SQLStatement stmt = new SQLStatement(ds);
        on_error stmt.rollback();
        stmt.prepare("INSERT INTO " + tableName + sprintf(" (%s) VALUES (",
            foldl $1 + ", " + $2, keys Columns) + valdef + ")");
        stmt.bindArgs(arguments);
        stmt.exec();
        stmt.commit();

        # bulk SQL is not working for firebird
        if (firebirdDB) {
            return;
        }

        hash<auto> results = Columns;
        foreach string key in (keys results) {
            if (exists results{key}.expected) {
                results{key} = results{key}.expected;
            } else {
                results{key} = results{key}.values;
            }
        }

        ret = ds.select("SELECT * FROM " + tableName);
        if (mssqlDB)
            trimHashOfLists(\ret);
        #printf("types test expected results: %N\n\n", results);
        #printf("types test actual results: %N\n\n", ret);
        assertEq(results, ret);

        on_exit ds.commit();
        ds.exec("DROP TABLE " + tableName);
    }

    timezoneTest() {
        if (no_odbc) {
            testSkip("no ODBC driver present");
        }

        Datasource tzDs(connStr);
        if (oracleDB) {
            tzDs.setOption("bigint-string", True);
        }
        tzDs.setOption("qore-timezone", "Asia/Tokyo");
        tzDs.open();

        try {
            tzDs.exec("DROP TABLE " + tableName);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "ODBC-EXEC-ERROR")
                rethrow;
        }
        tzDs.commit();

        on_error tzDs.rollback();
        any ret = tzDs.exec("CREATE TABLE " + tableName + " (id int, t " + (mssqlDB ? "datetime)" : "timestamp)"));
        assertTrue(ret == 0 || ret == -1 || ret.typeCode() == NOTHING);
        tzDs.commit();

        assertEq(1, tzDs.exec("INSERT INTO " + tableName + " (id, t) VALUES (%v, %v)", 1, 2016-01-11T00:00:00Z));
        tzDs.commit();
        assertEq(1, tzDs.exec("INSERT INTO " + tableName + " (id, t) VALUES (%v, %v)", 2, 2016-01-11T09:00:00+09:00));
        tzDs.commit();

        hash h = {"id": (1, 2), "t": (2016-01-11T09:00:00+09:00, 2016-01-11T09:00:00+09:00)};

        ret = tzDs.select("SELECT * FROM " + tableName);
        assertEq(h, ret);

        tzDs.close();
    }

    arrayBindTest() {
        if (no_odbc) {
            testSkip("no ODBC driver present");
        }

        # bulk SQL is not working for firebird
        if (firebirdDB) {
            return;
        }

        try {
            ds.exec("DROP TABLE " + tableName);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "ODBC-EXEC-ERROR")
                rethrow;
        }
        ds.commit();

        auto ret = ds.exec("CREATE TABLE " + tableName + " (id int, txt varchar(48))");
        assertTrue(ret == 0 || ret == -1 || ret.typeCode() == NOTHING);
        ds.commit();

        SQLStatement stmt = new SQLStatement(ds);
        on_error stmt.rollback();
        stmt.prepare("INSERT INTO " + tableName + " (id, txt) VALUES (%v, %v)");

        stmt.bindArgs((2, ("abc", "lorem", "text")));
        stmt.exec();
        stmt.commit();

        stmt.bindArgs(((4, 5), ("ipsum", "dolor")));
        stmt.exec();
        stmt.commit();

        stmt.execArgs( ((6,), "sit") );
        stmt.commit();

        hash<auto> h = {"id": (2, 2, 2, 4, 5, 6), "txt": ("abc", "lorem", "text", "ipsum", "dolor", "sit")};
        if (oracleDB) {
            h.id = (2n, 2n, 2n, 4n, 5n, 6n);
        }

        ret = ds.select("SELECT * FROM " + tableName + " order by id, txt");
        if (mssqlDB)
            trimHashOfLists(\ret);
        /*printf("ret: %N\n", ret);
        printf("h details\n---\n");
        foreach string s in (h.txt) {
            printf("%s: %d bytes, %d chars, %s\n", s, s.size(), s.length(), s.encoding());
        }
        printf("ret details\n---\n");
        foreach string s in (ret.txt) {
            printf("%s: %d bytes, %d chars, %s\n", s, s.size(), s.length(), s.encoding());
        }*/
        assertEq(h, ret);

        stmt = ds.getSQLStatement();
        stmt.prepare("select * from " + tableName + " order by id, txt");
        on_exit stmt.rollback();
        assertEq(h, stmt.fetchColumns(-1));

        stmt.prepare("select * from " + tableName + " order by id, txt");
        foreach hash<auto> row in (h.contextIterator()) {
            stmt.next();
            assertEq(row, stmt.getValue());
        }
        stmt.close();

        ds.exec("DROP TABLE " + tableName);
        ds.commit();

        ret = ds.exec("CREATE TABLE " + tableName + " (id int)");
        assertTrue(ret == 0 || ret == -1 || ret.typeCode() == NOTHING);
        ds.commit();

        stmt = ds.getSQLStatement();
        stmt.prepare("INSERT INTO " + tableName + " (id) VALUES (%v)");
        stmt.bindArgs((odbc_bind(ODBCT_SLONG, (7, 8, 9)),));
        stmt.exec();
        stmt.commit();

        assertEq({"id": oracleDB ? (7n, 8n, 9n) : (7, 8, 9)},
            ds.select("SELECT * FROM " + tableName + " ORDER BY id"));
    }

    connectionInfoTest() {
        if (no_odbc) {
            testSkip("no ODBC driver present");
        }

        # Test getClientVersion returns a valid version number
        int clientVer = ds.getClientVersion();
        assertTrue(clientVer > 0, "client version should be positive");

        # Test getServerVersion returns a valid version (int or hash depending on driver)
        auto serverVer = ds.getServerVersion();
        assertTrue(exists serverVer, "server version should exist");

        # Test getDriverRealName returns a non-empty string
        *string driverName = ds.getDriverRealName();
        assertTrue(exists driverName && driverName.length() > 0, "driver real name should not be empty");

        if (m_options.verbose > 2) {
            printf("Client version: %d (%s)\n", clientVer, getVersionString(clientVer));
            printf("Server version: %y\n", serverVer);
            printf("Driver real name: %s\n", driverName);
        }
    }

    optionsTest() {
        if (no_odbc) {
            testSkip("no ODBC driver present");
        }

        # Test numeric number options
        {
            Datasource optDs(connStr);
            optDs.open();
            on_exit optDs.close();

            # Test optimal-numbers (default)
            assertTrue(optDs.getOption("optimal-numbers"), "optimal-numbers should be True by default");
            assertFalse(optDs.getOption("string-numbers"), "string-numbers should be False by default");
            assertFalse(optDs.getOption("numeric-numbers"), "numeric-numbers should be False by default");

            # Set string-numbers
            optDs.setOption("string-numbers", True);
            assertFalse(optDs.getOption("optimal-numbers"), "optimal-numbers should be False after setting string-numbers");
            assertTrue(optDs.getOption("string-numbers"), "string-numbers should be True after setting it");
            assertFalse(optDs.getOption("numeric-numbers"), "numeric-numbers should be False after setting string-numbers");

            # Set numeric-numbers
            optDs.setOption("numeric-numbers", True);
            assertFalse(optDs.getOption("optimal-numbers"), "optimal-numbers should be False after setting numeric-numbers");
            assertFalse(optDs.getOption("string-numbers"), "string-numbers should be False after setting numeric-numbers");
            assertTrue(optDs.getOption("numeric-numbers"), "numeric-numbers should be True after setting it");

            # Set optimal-numbers
            optDs.setOption("optimal-numbers", True);
            assertTrue(optDs.getOption("optimal-numbers"), "optimal-numbers should be True after setting it");
            assertFalse(optDs.getOption("string-numbers"), "string-numbers should be False after setting optimal-numbers");
            assertFalse(optDs.getOption("numeric-numbers"), "numeric-numbers should be False after setting optimal-numbers");
        }

        # Test bigint options
        {
            Datasource optDs(connStr);
            optDs.open();
            on_exit optDs.close();

            # Test bigint-native (default)
            assertTrue(optDs.getOption("bigint-native"), "bigint-native should be True by default");
            assertFalse(optDs.getOption("bigint-string"), "bigint-string should be False by default");

            # Set bigint-string
            optDs.setOption("bigint-string", True);
            assertFalse(optDs.getOption("bigint-native"), "bigint-native should be False after setting bigint-string");
            assertTrue(optDs.getOption("bigint-string"), "bigint-string should be True after setting it");

            # Set bigint-native
            optDs.setOption("bigint-native", True);
            assertTrue(optDs.getOption("bigint-native"), "bigint-native should be True after setting it");
            assertFalse(optDs.getOption("bigint-string"), "bigint-string should be False after setting bigint-native");
        }

        # Test fractional-precision option
        {
            Datasource optDs(connStr);
            optDs.open();
            on_exit optDs.close();

            # Default should be reasonable (typically 3 or 6)
            int frPrec = optDs.getOption("fractional-precision");
            assertTrue(frPrec >= 1 && frPrec <= 9, "fractional-precision should be between 1 and 9");

            # Set fractional-precision to different values
            optDs.setOption("fractional-precision", 9);
            assertEq(9, optDs.getOption("fractional-precision"), "fractional-precision should be 9 after setting it");

            optDs.setOption("fractional-precision", 1);
            assertEq(1, optDs.getOption("fractional-precision"), "fractional-precision should be 1 after setting it");

            # Test invalid values raise exceptions
            assertThrows("ODBC-OPTION-ERROR", sub() { optDs.setOption("fractional-precision", 0); });
            assertThrows("ODBC-OPTION-ERROR", sub() { optDs.setOption("fractional-precision", 10); });
        }

        # Test timeout options
        {
            Datasource optDs(connStr);
            optDs.open();
            on_exit optDs.close();

            # Test login-timeout
            int loginTimeout = optDs.getOption("login-timeout");
            assertTrue(loginTimeout >= 0, "login-timeout should be >= 0");

            # Test connection-timeout
            int connTimeout = optDs.getOption("connection-timeout");
            assertTrue(connTimeout >= 0, "connection-timeout should be >= 0");

            # Verify getOption returns correct values (this tests the bug fix for swapped values)
            optDs.setOption("login-timeout", 30);
            optDs.setOption("connection-timeout", 60);
            assertEq(30, optDs.getOption("login-timeout"), "login-timeout should return 30");
            assertEq(60, optDs.getOption("connection-timeout"), "connection-timeout should return 60");

            # Test with different values to confirm no swapping
            optDs.setOption("login-timeout", 100);
            optDs.setOption("connection-timeout", 200);
            assertEq(100, optDs.getOption("login-timeout"), "login-timeout should return 100");
            assertEq(200, optDs.getOption("connection-timeout"), "connection-timeout should return 200");

            # Test invalid timeout values
            assertThrows("ODBC-OPTION-ERROR", sub() { optDs.setOption("login-timeout", "abc"); });
            assertThrows("ODBC-OPTION-ERROR", sub() { optDs.setOption("connection-timeout", "xyz"); });
        }

        # Test qore-timezone option
        {
            Datasource optDs(connStr);
            optDs.setOption("qore-timezone", "UTC");
            optDs.open();
            on_exit optDs.close();

            string tz = optDs.getOption("qore-timezone");
            assertTrue(exists tz && tz.length() > 0, "qore-timezone should return a timezone string");
        }

        # Test preserve-case option
        {
            Datasource optDs(connStr);
            optDs.open();
            on_exit optDs.close();

            # Set preserve-case to True
            optDs.setOption("preserve-case", True);
            # Note: We can't easily test the effect without creating tables, but we can verify the option is accepted
        }

        if (m_options.verbose > 2) {
            printf("Options test completed successfully\n");
        }
    }

    statementOpsTest() {
        if (no_odbc) {
            testSkip("no ODBC driver present");
        }

        try {
            ds.exec("DROP TABLE " + tableName);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "ODBC-EXEC-ERROR")
                rethrow;
        }
        ds.commit();

        # Create test table
        auto ret = ds.exec("CREATE TABLE " + tableName + " (id int PRIMARY KEY, name varchar(64), value decimal(10,2))");
        assertTrue(ret == 0 || ret == -1 || ret.typeCode() == NOTHING);
        ds.commit();

        on_exit {
            try {
                ds.exec("DROP TABLE " + tableName);
                ds.commit();
            } catch (hash<ExceptionInfo> ex) {}
        }

        # Insert test data
        ds.exec("INSERT INTO " + tableName + " (id, name, value) VALUES (%v, %v, %v)", 1, "Alice", 100.50n);
        ds.exec("INSERT INTO " + tableName + " (id, name, value) VALUES (%v, %v, %v)", 2, "Bob", 200.75n);
        ds.exec("INSERT INTO " + tableName + " (id, name, value) VALUES (%v, %v, %v)", 3, "Charlie", 300.25n);
        ds.commit();

        # Test SQLStatement fetchRow
        {
            SQLStatement stmt = ds.getSQLStatement();
            stmt.prepare("SELECT * FROM " + tableName + " WHERE id = %v");
            stmt.bindArgs((1,));
            stmt.exec();
            on_exit stmt.close();

            assertTrue(stmt.next(), "next() should return True for first row");
            hash<auto> row = stmt.getValue();
            assertEq(oracleDB ? 1n : 1, row.id ?? row.ID, "id should be 1");
            assertEq("Alice", trim(row.name ?? row.NAME), "name should be Alice");
        }

        # Test SQLStatement fetchRows with limit
        {
            SQLStatement stmt = ds.getSQLStatement();
            stmt.prepare("SELECT * FROM " + tableName + " ORDER BY id");
            stmt.exec();
            on_exit stmt.close();

            # Fetch first 2 rows
            list<auto> rows = stmt.fetchRows(2);
            assertEq(2, rows.size(), "should fetch exactly 2 rows");
        }

        # Test SQLStatement fetchColumns
        {
            SQLStatement stmt = ds.getSQLStatement();
            stmt.prepare("SELECT * FROM " + tableName + " ORDER BY id");
            stmt.exec();
            on_exit stmt.close();

            hash<auto> cols = stmt.fetchColumns(-1);
            assertTrue(cols.hasKey("id") || cols.hasKey("ID"), "result should have id column");
            assertTrue(cols.hasKey("name") || cols.hasKey("NAME"), "result should have name column");
            auto idCol = cols.id ?? cols.ID;
            assertEq(3, idCol.size(), "id column should have 3 values");
        }

        # Test SQLStatement fetchColumnar
        {
            SQLStatement stmt = ds.getSQLStatement();
            stmt.prepare("SELECT id, name FROM " + tableName + " ORDER BY id");
            stmt.exec();
            on_exit stmt.close();

            ColumnarResult first = stmt.fetchColumnar(rows: 2);
            ColumnarResult rest = stmt.fetchColumnar(rows: -1);
            assertEq(2, first.numRows(), "first columnar fetch should honor row limit");
            assertEq(1, rest.numRows(), "second columnar fetch should return remaining rows");
            assertEq((1, 2), map int($1), asList(getColumn(first, "id")));
            assertEq((3,), map int($1), asList(getColumn(rest, "id")));
            assertEq(("Alice", "Bob"), map trim($1), asList(getColumn(first, "name")));
            assertEq(("Charlie",), map trim($1), asList(getColumn(rest, "name")));
        }

        # Test SQLStatement describe
        {
            SQLStatement stmt = ds.getSQLStatement();
            stmt.prepare("SELECT * FROM " + tableName);
            stmt.exec();
            on_exit stmt.close();

            hash<auto> desc = stmt.describe();
            assertTrue(desc.size() > 0, "describe should return column information");

            if (m_options.verbose > 2) {
                printf("Statement describe: %N\n", desc);
            }
        }

        # Test affectedRows
        {
            SQLStatement stmt = ds.getSQLStatement();
            stmt.prepare("UPDATE " + tableName + " SET value = %v WHERE id = %v");
            stmt.bindArgs((150.00n, 1));
            stmt.exec();
            on_exit stmt.rollback();

            int affected = stmt.affectedRows();
            assertEq(1, affected, "affectedRows should be 1");
        }

        # Test selectRow returns single row
        {
            hash<auto> row = ds.selectRow("SELECT * FROM " + tableName + " WHERE id = %v", 1);
            assertTrue(exists row, "selectRow should return a row");
            assertEq(oracleDB ? 1n : 1, row.id ?? row.ID, "id should be 1");
        }

        # Test selectRow with multiple rows should throw
        {
            assertThrows("ODBC-SELECT-ROW-ERROR", sub() {
                ds.selectRow("SELECT * FROM " + tableName);
            });
        }

        # Test bindPlaceholders throws expected error
        {
            SQLStatement stmt = ds.getSQLStatement();
            stmt.prepare("SELECT * FROM " + tableName + " WHERE id = %v");
            assertThrows("ODBC-BIND-PLACEHOLDERS-ERROR", sub() {
                stmt.bindPlaceholders(Type::Int);
            });
            stmt.close();
        }

        if (m_options.verbose > 2) {
            printf("Statement operations test completed successfully\n");
        }
    }

}
