#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

# Tests that the exceptions of a connection that cannot be opened show none of its user name, password, DSN or
# database, nor any other secret value of the connection string, in any form in which the connection can be given
# (datasource arguments, a datasource string, the "conn" option and a DSN), while still naming the
# problem and the SQLSTATE; the driver's and server's diagnostics are kept with these values masked (qore#6994).
#
# It also tests that a password with ';', '{', '}' and '=' reaches the driver unchanged, so the login succeeds.
#
# The connections that fail before reaching a server need no database: they connect to a local port with no
# listener. The cases that need a server (a login rejected by the server, an unknown database, and the successful
# login) use the PostgreSQL server given in QORE_DB_CONNSTR_ODBC, with a user that can create roles, and are skipped
# without one.

%modern

%requires QUnit
%requires Util

# load the locally-built odbc binary module from the build directory
%prepend-module-path "${SCRIPT_DIR}/../build"
%requires odbc

%exec-class ConnectionSecretsTest

class ConnectionSecretsTest inherits QUnit::Test {
    public {
        const User = "u_SECRET1";
        const Db = "d_SECRET3";
        #! passwords with each character that has a meaning in a connection string
        const Passwords = (
            "p_SECRET2;TAIL_SECRET4",
            "p_SECRET2{TAIL_SECRET4",
            "p_SECRET2}TAIL_SECRET4",
            "p_SECRET2=TAIL_SECRET4",
            "{p_SECRET2}TAIL_SECRET4",
            "p_SECRET2;TAIL_SECRET4}",
        );
        #! secret values of other keys of a connection string
        const SslPass = "s_SECRET5";
        #! a libpq option name in the pqopt value of a DSN
        const PqoptKey = "o_SECRET7";
        const Token = "t_SECRET6";

        #! every part of every secret; all of them contain "SECRET", which must not appear in any case
        const Fragments = (User, Db, "p_SECRET2", "TAIL_SECRET4", SslPass, Token, PqoptKey, "SECRET");

        #! a driver name that is not defined
        const NoDriver = "qore_odbc_no_such_driver";

        #! the PostgreSQL ODBC driver names to look for
        const PgDrivers = ("PostgreSQL Unicode", "PostgreSQL", "PostgreSQL ANSI");

        #! the password of the test role in the server tests, with all special characters
        const RolePass = "r;p{w}x=y;z}";
    }

    private {
        #! a socket bound to a local port without listening: connections to it are refused
        Socket closed();
        int port;

        #! the PostgreSQL ODBC driver, or NoDriver
        string driver = NoDriver;
        bool have_driver;

        #! the directory with the odbc.ini of the DSN test
        *string ini_dir;
        #! the value of ODBCINI before the test
        *string old_odbcini;

        #! the server tests: the admin datasource, and the server's host and port
        *Datasource admin;
        *string server_host;
        *string server_port;
        *string server_db;
        *string server_skip;
        #! the roles created
        list<string> roles = ();
    }

    constructor() : QUnit::Test("ODBC connection secrets", "1.0", \ARGV) {
        addTestCase("datasource arguments with a connection string", \argsConnStr());
        addTestCase("datasource arguments with a DSN that is not defined", \argsDsn());
        addTestCase("a DSN that is defined", \definedDsn());
        addTestCase("a DSN with the user name, password and database", \dsnValues());
        addTestCase("passwords that are part of the SQLSTATE prefix", \sqlstatePasswords());
        addTestCase("a datasource string", \datasourceString());
        addTestCase("the conn option", \connOption());
        addTestCase("a conn option that cannot be parsed", \badConnOption());
        addTestCase("a login rejected by the server", \serverRejected());
        addTestCase("a database that does not exist", \serverNoDatabase());
        addTestCase("a DSN whose values the server rejects", \serverDsnRejected());
        addTestCase("a password with special characters logs in", \specialPasswordLogin());
        set_return_value(main());
    }

    globalSetUp() {
        closed.bind("127.0.0.1:0");
        port = closed.getSocketInfo().port;

        # the PostgreSQL ODBC driver
        *string conn_driver;
        if (ENV.QORE_DB_CONNSTR_ODBC) {
            *hash<auto> opts = parse_datasource(ENV.QORE_DB_CONNSTR_ODBC).options;
            conn_driver = (opts.conn =~ x/DRIVER=\{?([^;}]+)/i)[0];
        }
        list<string> candidates = PgDrivers;
        if (conn_driver) {
            unshift candidates, conn_driver;
        }
        foreach string name in (candidates) {
            if (driverDefined(name)) {
                driver = name;
                have_driver = True;
                break;
            }
        }

        # before ODBCINI is set: QORE_DB_CONNSTR_ODBC could use a DSN
        setUpServer();

        # a DSN named like the database, to a port with no listener
        if (have_driver) {
            ini_dir = sprintf("%s/odbc-secrets-%d-%d", tmp_location(), getpid(), now_us().durationMicroseconds());
            mkdir(ini_dir, 0700);
            File f();
            f.open2(ini_dir + "/odbc.ini", O_CREAT | O_TRUNC | O_WRONLY, 0600);
            f.printf("[%s]\nDriver=%s\nServername=127.0.0.1\nPort=%d\nDatabase=postgres\n", Db, driver, port);
            # a DSN with the user name, password and database, to a port with no listener
            # its libpq options make libpq fail before connecting, naming the option, so that the driver's message
            # shows a value of the DSN
            f.printf("[dsn_values]\nDriver=%s\nServername=127.0.0.1\nPort=%d\nDatabase=%s\nUsername=%s\n"
                "Password=%s\nPqopt=%s=1\n", driver, port, Db, User, Passwords[0], PqoptKey);
            # the same values for the server, which rejects the user
            if (!server_skip) {
                f.printf("[dsn_server]\nDriver=%s\nServername=%s\nPort=%s\nDatabase=%s\nUsername=%s\n"
                    "Password=%s\n", driver, server_host, server_port, server_db, User, Passwords[0]);
            }
            f.close();
            # read by the driver manager for each connection
            old_odbcini = ENV.ODBCINI;
            setenv("ODBCINI", ini_dir + "/odbc.ini");
        }
    }

    globalTearDown() {
        if (admin) {
            foreach string role in (roles) {
                try {
                    admin.exec("drop role if exists " + role);
                    admin.commit();
                } catch (hash<ExceptionInfo> ex) {
                    printf("could not drop role %s: %s: %s\n", role, ex.err, ex.desc);
                    admin.rollback();
                }
            }
            admin.close();
        }
        if (ini_dir) {
            unlink(ini_dir + "/odbc.ini");
            rmdir(ini_dir);
            if (exists old_odbcini) {
                setenv("ODBCINI", old_odbcini);
            } else {
                unsetenv("ODBCINI");
            }
        }
        closed.close();
    }

    argsConnStr() {
        foreach string pass in (Passwords) {
            string db = sprintf("DRIVER={%s};Servername=127.0.0.1;Port=%d;Database=%s", driver, port, Db);
            hash<ExceptionInfo> ex = connectEx("odbc", User, pass, db, NOTHING, "arguments " + pass);
            checkConnectError(ex, "arguments " + pass, True);
        }
    }

    argsDsn() {
        foreach string pass in (Passwords) {
            # not the DSN of the odbc.ini of this test
            hash<ExceptionInfo> ex = connectEx("odbc", User, pass, Db + "_x", NOTHING, "DSN " + pass);
            checkConnectError(ex, "DSN " + pass, False);
            # the driver manager does not know the DSN
            assertRegex("\\[IM002\\]", ex.desc, "DSN " + pass);
        }
    }

    definedDsn() {
        if (!have_driver) {
            testSkip("no PostgreSQL ODBC driver is defined");
        }
        foreach string pass in (Passwords) {
            hash<ExceptionInfo> ex = connectEx("odbc", User, pass, Db, NOTHING, "defined DSN " + pass);
            checkConnectError(ex, "defined DSN " + pass, False);
            # the driver reached the port, which refused the connection
            assertRegex("\\[08001\\]", ex.desc, "defined DSN " + pass);
        }
    }

    dsnValues() {
        if (!have_driver) {
            testSkip("no PostgreSQL ODBC driver is defined");
        }
        hash<ExceptionInfo> ex = connectEx("odbc", NOTHING, NOTHING, "dsn_values", NOTHING, "DSN values");
        checkConnectError(ex, "DSN values", False);
        assertRegex("\\[08001\\]", ex.desc);
        # libpq named the option of the DSN, which is masked
        assertRegex("invalid connection option \"\\*\\*\\*\\*\"", ex.desc);
    }

    sqlstatePasswords() {
        # values that occur in the "; [SQLSTATE] (native N): " prefix of each record, which is never masked
        foreach string pass in ("08001", "IM002", "0", "1", "native", "101") {
            string db = sprintf("DRIVER={%s};Servername=127.0.0.1;Port=%d;Database=%s", driver, port, Db);
            hash<ExceptionInfo> ex = connectEx("odbc", User, pass, db, NOTHING, "password " + pass);
            checkConnectError(ex, "password " + pass, True);
            # the SQLSTATE and native code are those of the driver (psqlODBC), or of the driver manager, which does
            # not find the driver (IM002) or cannot load it (01000)
            assertRegex(have_driver ? "; \\[08001\\] \\(native 101\\): " : "; \\[(IM002|01000)\\] \\(native 0\\): ",
                ex.desc, "password " + pass);
        }
    }

    datasourceString() {
        # passwords that can be written in a datasource string
        foreach string pass in ("p_SECRET2;TAIL_SECRET4", "p_SECRET2=TAIL_SECRET4") {
            string str = sprintf("odbc:%s/%s@%s(UTF8){conn=DRIVER=%s;Servername=127.0.0.1;Port=%d}", User, pass,
                Db, driver, port);
            string label = "datasource string " + pass;
            hash<ExceptionInfo> ex;
            try {
                Datasource ds(str);
                ds.open();
                fail(label + ": no exception");
            } catch (hash<ExceptionInfo> e) {
                ex = e;
            }
            checkConnectError(ex, label, False);
        }
    }

    connOption() {
        foreach string pass in (Passwords) {
            string conn = sprintf("DRIVER={%s};Servername=127.0.0.1;Port=%d;Database=%s;UID=%s;PWD=%s;"
                "SSLPassword=%s;AccessToken=%s", driver, port, Db, User, brace(pass), SslPass, Token);
            hash<ExceptionInfo> ex = connectEx("odbc", NOTHING, NOTHING, NOTHING, {"conn": conn}, "conn " + pass);
            checkConnectError(ex, "conn " + pass, True);
        }
    }

    badConnOption() {
        # the password is not in braces: with ';' or '{' the connection string cannot be parsed and every value is
        # masked; with '=' or '}' it is parsed, and the secret keys are masked
        foreach string pass in (Passwords) {
            string conn = sprintf("DRIVER={%s};Servername=127.0.0.1;Port=%d;Database=%s;UID=%s;PWD=%s", driver,
                port, Db, User, pass);
            hash<ExceptionInfo> ex = connectEx("odbc", NOTHING, NOTHING, NOTHING, {"conn": conn},
                "unparsed conn " + pass);
            checkNoSecrets(ex, "unparsed conn " + pass);
            assertEq("ODBC-CONNECTION-ERROR", ex.err, "unparsed conn " + pass);
            assertRegex("\\[[0-9A-Z]{5}\\]", ex.desc, "unparsed conn " + pass);
        }
    }

    serverRejected() {
        checkServer();
        foreach string pass in (Passwords) {
            string db = sprintf("DRIVER={%s};Servername=%s;Port=%s;Database=%s", driver, server_host, server_port,
                server_db);
            string label = "rejected " + pass;
            hash<ExceptionInfo> ex = connectEx("odbc", User, pass, db, NOTHING, label);
            checkConnectError(ex, label, True);
            assertRegex("\\[08001\\]", ex.desc, label);
            # the server named the user, which is masked
            assertRegex("\"\\*\\*\\*\\*\"", ex.desc, label);
        }
        # a user name longer than the server's maximum name length, which the server shows cut
        {
            string long_user = User + strmul("x", 80);
            string db = sprintf("DRIVER={%s};Servername=%s;Port=%s;Database=%s", driver, server_host, server_port,
                server_db);
            hash<ExceptionInfo> ex = connectEx("odbc", long_user, Passwords[0], db, NOTHING, "long user");
            checkConnectError(ex, "long user", True);
            assertRegex("\"\\*\\*\\*\\*\"", ex.desc, "long user");
        }
    }

    serverNoDatabase() {
        checkServer();
        string role = createRole();
        string db = sprintf("DRIVER={%s};Servername=%s;Port=%s;Database=%s", driver, server_host, server_port, Db);
        hash<ExceptionInfo> ex = connectEx("odbc", role, RolePass, db, NOTHING, "no database");
        checkConnectError(ex, "no database", True);
        assertRegex("\\[08001\\]", ex.desc);
        # the server named the database, which is masked
        assertRegex("database \"\\*\\*\\*\\*\" does not exist", ex.desc);
        # the user name and password are masked too
        assertEq(-1, ex.desc.find(role), ex.desc);
        assertEq(-1, ex.desc.find(RolePass), ex.desc);
    }

    serverDsnRejected() {
        checkServer();
        # the user name and password are only in the DSN
        hash<ExceptionInfo> ex = connectEx("odbc", NOTHING, NOTHING, "dsn_server", NOTHING, "server DSN");
        checkConnectError(ex, "server DSN", False);
        assertRegex("\\[08001\\]", ex.desc);
        # the server named the user of the DSN, which is masked
        assertRegex("\"\\*\\*\\*\\*\"", ex.desc);
    }

    specialPasswordLogin() {
        checkServer();
        string role = createRole();
        # the password in the datasource arguments
        {
            string db = sprintf("DRIVER={%s};Servername=%s;Port=%s;Database=%s", driver, server_host, server_port,
                server_db);
            Datasource ds("odbc", role, RolePass, db);
            ds.open();
            on_exit ds.close();
            assertEq(role, ds.selectRow("select current_user as u").u);
        }
        # the user and password in the conn option, the password in braces
        {
            string conn = sprintf("DRIVER={%s};Servername=%s;Port=%s;Database=%s;UID=%s;PWD=%s", driver, server_host,
                server_port, server_db, role, brace(RolePass));
            Datasource ds("odbc", NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, {"conn": conn});
            ds.open();
            on_exit ds.close();
            assertEq(role, ds.selectRow("select current_user as u").u);
        }
    }

    #! returns the value in braces for a connection string
    private static string brace(string v) {
        return "{" + replace(v, "}", "}}") + "}";
    }

    #! true if the ODBC driver is defined in an odbcinst.ini
    private static bool driverDefined(string name) {
        # the driver manager reads only the directory of ODBCSYSINI if it is set
        list<string> files = ENV.ODBCSYSINI
            ? (ENV.ODBCSYSINI + "/odbcinst.ini",)
            : ("/etc/odbcinst.ini", "/usr/local/etc/odbcinst.ini", "/etc/unixODBC/odbcinst.ini");
        foreach string file in (files) {
            if (!is_readable(file)) {
                continue;
            }
            foreach string line in (ReadOnlyFile::readTextFile(file).split("\n")) {
                if (trim(line) == "[" + name + "]") {
                    return True;
                }
            }
        }
        return False;
    }

    #! sets up the server tests from QORE_DB_CONNSTR_ODBC
    private setUpServer() {
        if (!ENV.QORE_DB_CONNSTR_ODBC) {
            server_skip = "QORE_DB_CONNSTR_ODBC is not set";
            return;
        }
        if (!have_driver) {
            server_skip = "no PostgreSQL ODBC driver is defined";
            return;
        }
        hash<auto> h = parse_datasource(ENV.QORE_DB_CONNSTR_ODBC);
        string conn = h.options.conn ?? "";
        server_host = (conn =~ x/(?:^|;)\s*Server(?:name)?\s*=\s*([^;]+)/i)[0] ?? h.host;
        server_port = (conn =~ x/(?:^|;)\s*Port\s*=\s*([^;]+)/i)[0] ?? (h.port ? h.port.toString() : "5432");
        server_db = (conn =~ x/(?:^|;)\s*Database\s*=\s*([^;]+)/i)[0];
        if (!server_host || !server_db) {
            server_skip = "QORE_DB_CONNSTR_ODBC does not give the server and database in its conn option";
            return;
        }
        try {
            Datasource ds(ENV.QORE_DB_CONNSTR_ODBC);
            ds.open();
            if (ds.getDriverRealName() != "PostgreSQL") {
                server_skip = "QORE_DB_CONNSTR_ODBC is not a PostgreSQL connection";
                ds.close();
                return;
            }
            if (!ds.selectRow("select rolcreaterole or rolsuper as ok from pg_roles where rolname = current_user").ok) {
                server_skip = "the user of QORE_DB_CONNSTR_ODBC cannot create roles";
                ds.close();
                return;
            }
            admin = ds;
        } catch (hash<ExceptionInfo> ex) {
            server_skip = sprintf("cannot connect with QORE_DB_CONNSTR_ODBC: %s", ex.err);
        }
    }

    private checkServer() {
        if (server_skip) {
            testSkip(server_skip);
        }
    }

    #! creates a role with RolePass that can log in, dropped in globalTearDown()
    private string createRole() {
        string role = sprintf("qore_odbc_6994_%d_%d", getpid(), roles.size());
        admin.exec(sprintf("create role %s login password '%s'", role, RolePass));
        admin.commit();
        roles += role;
        return role;
    }

    #! returns the exception of opening the datasource, or fails the test case
    private hash<ExceptionInfo> connectEx(string type, *string user, *string pass, *string db, *hash<auto> opts,
            string label) {
        try {
            Datasource ds(type, user, pass, db, NOTHING, NOTHING, NOTHING, opts);
            ds.open();
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        fail(label + ": no exception was raised");
        # not reached
        return <ExceptionInfo>{};
    }

    #! returns the text of an exception and the exceptions chained to it: their error codes, descriptions and
    #! arguments
    private static string getText(*hash<ExceptionInfo> ex) {
        string text;
        while (ex) {
            text += sprintf("%s: %s: %y\n", ex.err, ex.desc, ex.arg);
            ex = ex.next;
        }
        return text;
    }

    #! checks that the exception and the exceptions chained to it show no part of any secret
    private checkNoSecrets(hash<ExceptionInfo> ex, string label) {
        string text = getText(ex);
        string ltext = text.lwr();
        foreach string secret in (Fragments) {
            assertEq(-1, ltext.find(secret.lwr()), sprintf("%s: the exception shows %y: %s", label, secret, text));
        }
    }

    #! checks a connection error: no secrets, the problem, the driver if given, and the SQLSTATE
    private checkConnectError(hash<ExceptionInfo> ex, string label, bool with_driver) {
        checkNoSecrets(ex, label);
        assertEq("ODBC-CONNECTION-ERROR", ex.err, sprintf("%s: %s", label, getText(ex)));
        assertRegex("^could not connect to the datasource", ex.desc, label);
        if (with_driver) {
            string prefix = "could not connect to the datasource with the ODBC driver '" + driver + "'";
            assertEq(0, ex.desc.find(prefix), label);
        }
        # the SQLSTATE of the driver's diagnostics
        assertRegex("; \\[[0-9A-Z]{5}\\] \\(native -?[0-9]+\\): ", ex.desc, label);
    }
}
