set -eu
fixture_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if rpm -q psqlODBC >/dev/null 2>&1; then
    driver_package=psqlODBC
else
    driver_package=postgresql-odbc
fi
driver=$(rpm -ql "$driver_package" | sed -n '\|/psqlodbcw\.so$|p')
test -f "$driver"
bindir=$(dirname -- "$(command -v initdb)")
exec python3 -B "$fixture_dir/with-postgres.py" --driver "$driver" --bindir "$bindir" -- "$fixture_dir/run-suites" "$@"
