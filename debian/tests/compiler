set -eu
export LC_ALL=C.UTF-8
unset QORE_MODULE_DIR QORE_MODULE_DIR_ONLY QORE_INCLUDE_DIR LD_LIBRARY_PATH LD_PRELOAD
cp debian/tests/with-database "$AUTOPKGTEST_TMP/"
cd "$AUTOPKGTEST_TMP"
cat > odbc-smoke.q <<'EOF'
%modern
%requires odbc
int sub main() {
    Datasource db(ENV.QORE_DB_CONNSTR_ODBC);
    on_exit db.close();
    db.exec("create temporary table smoke (id integer, value text)");
    db.exec("insert into smoke values (%v, %v)", odbc_bind(ODBCT_SLONG, 42), "odbc-aot-ok");
    db.commit();
    hash<auto> row = db.selectRow("select id, value from smoke");
    return row.id == 42 && row.value == "odbc-aot-ok" ? 0 : 1;
}
exit(main());
EOF
/usr/bin/qcc -o odbc-smoke odbc-smoke.q
./with-database ./odbc-smoke
